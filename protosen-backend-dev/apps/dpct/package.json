{
  "name": "@protosen/dpct",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev-app": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register ./src/app.ts",
    "dev-grpc": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register ./grpc/server.ts",
    "dev": "concurrently 'npm run dev-app' 'npm run dev-grpc'",
    "generate:grpc": "sh scripts/generate-grpc.sh",
    "start-app": "node ./build/src/app.js",
    "start-grpc": "node ./build/grpc/server.js",
    "start": "concurrently 'npm run start-app' 'npm run start-grpc'",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && sh scripts/copy-proto.sh",
    "format": "prettier --write 'src/**/*.{js,ts,md,json}' --config ./.prettierrc",
    "lint": "eslint src grpc",
    "lint:fix": "eslint src grpc --fix",
    "fix": "npm run format && npm run lint:fix",
    "prepare": "husky install",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:integration": "NODE_ENV=test jest tests/integration",
    "test:unit": "NODE_ENV=test jest tests/unit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@protosen/shared": "*",
    "@aws-sdk/client-s3": "^3.495.0",
    "@aws-sdk/s3-request-presigner": "^3.495.0",
    "@bufbuild/protobuf": "^2.2.3",
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "@grpc/reflection": "^1.0.4",
    "@types/sequelize": "^4.28.20",
    "@types/swagger-jsdoc": "^6.0.4",
    "argon2": "^0.31.2",
    "axios": "^1.6.5",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "grpc-health-check": "^2.0.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.1",
    "sequelize": "^6.35.2",
    "sequelize-typescript": "^2.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsoa": "^6.0.1",
    "uuid": "^9.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^9.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/google-protobuf": "^3.15.12",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.24",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@types/yamljs": "^0.2.34",
    "enforce-branch-name": "^1.1.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.13.0",
    "husky": "^8.0.3",
    "jest": "^30.2.0",
    "jest-extended": "^7.0.0",
    "prettier": "^3.1.1",
    "sequelize-auto": "^0.8.8",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "ts-proto": "^2.6.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.49.0",
    "vitepress": "^1.6.4"
  }
}
