# =============================================================================
# Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# IMPORTANT: Never commit .env files with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# NODE_ENV: Application environment mode
# Options: development | production | test
# Default: development
NODE_ENV=development

# PORT: Express API server port
# Default: 5002
PORT=5002

# LOG_LEVEL: Pino logger level
# Options: fatal | error | warn | info | debug | trace
# Default: info
LOG_LEVEL=info

# CORS_ALLOWED_ORIGINS: comma-separated allowed origins for browser calls
# Example: https://protosen.2ticglobal.com,https://protosendev.gouv.sn,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
# POSTGRES_DB: Database name (required)
POSTGRES_DB=your_database_name

# POSTGRES_USER: Database user (required)
POSTGRES_USER=your_database_user

# POSTGRES_PASSWORD: Database password (required)
POSTGRES_PASSWORD=your_secure_password

# POSTGRES_HOST: Database host address (required)
# Examples: localhost, 127.0.0.1, your-rds-instance.amazonaws.com
POSTGRES_HOST=localhost

# POSTGRES_PORT: Database port
# Default: 5432
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate RSA key pairs and encode them in base64:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -i private.pem
#   base64 -i public.pem

# ACCESS_TOKEN_PUBLIC_KEY: Base64-encoded RSA public key for access tokens (required)
ACCESS_TOKEN_PUBLIC_KEY=your_base64_encoded_public_key

# ACCESS_TOKEN_PRIVATE_KEY: Base64-encoded RSA private key for access tokens (required)
ACCESS_TOKEN_PRIVATE_KEY=your_base64_encoded_private_key

# REFRESH_PUBLIC_KEY: Base64-encoded RSA public key for refresh tokens (required)
REFRESH_PUBLIC_KEY=your_base64_encoded_refresh_public_key

# REFRESH_PRIVATE_KEY: Base64-encoded RSA private key for refresh tokens (required)
REFRESH_PRIVATE_KEY=your_base64_encoded_refresh_private_key

# JWT_EXPIRES_IN: Access token expiration time (required)
# Examples: 15m, 1h, 1d
JWT_EXPIRES_IN=1h

# JWT_REFRESH_EXPIRES_IN: Refresh token expiration time (required)
# Examples: 7d, 30d, 100h
JWT_REFRESH_EXPIRES_IN=100h

# -----------------------------------------------------------------------------
# AWS S3 Storage
# -----------------------------------------------------------------------------
# ACCESS_KEY: AWS IAM access key ID (required)
ACCESS_KEY=your_aws_access_key_id

# SECRET_KEY: AWS IAM secret access key (required)
SECRET_KEY=your_aws_secret_access_key

# BUCKET_NAME: S3 bucket name (required)
BUCKET_NAME=your_bucket_name

# BUCKET_REGION: AWS region for S3 bucket (required)
# Examples: us-east-1, eu-west-3, ap-southeast-1
BUCKET_REGION=us-east-1

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
# MAIL_HOST: SMTP server hostname (required)
# Examples: smtp.gmail.com, smtp-relay.brevo.com
MAIL_HOST=smtp.example.com

# MAIL_USER: SMTP authentication username (required)
MAIL_USER=your_smtp_username

# MAIL_PASS: SMTP authentication password (required)
MAIL_PASS=your_smtp_password

# MAIL_SERVICE: Email service name (optional)
# Examples: gmail, outlook, brevo
# MAIL_SERVICE=

# MAIL_PORT: SMTP port (optional)
# Common ports: 25, 465 (SSL), 587 (TLS)
# MAIL_PORT=587

# -----------------------------------------------------------------------------
# gRPC Server
# -----------------------------------------------------------------------------
# GRPC_PORT: gRPC server port
# Default: 50051
GRPC_PORT=50051

# GRPC_API_KEY: API key for gRPC authentication (required)
# Generate a secure random string (32+ characters recommended)
GRPC_API_KEY=your_secure_grpc_api_key

# GRPC_ENABLE_REFLECTION: Enable gRPC reflection service
# Options: true | false
# Default: false
# WARNING: Only enable in development/testing environments for security reasons
GRPC_ENABLE_REFLECTION=false
